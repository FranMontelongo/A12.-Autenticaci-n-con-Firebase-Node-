<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            background: white;
            padding: 35px;
            border-radius: 12px;
            width: 350px;
            box-shadow: 0 4px 15px #00000015;
        }

        h1 { text-align: center; }

        input, button {
            width: 100%;
            padding: 12px;
            margin-top: 12px;
            box-sizing: border-box;
        }

        button {
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .error { color: red; }
        p { text-align: center; }
    </style>
</head>
<body>

    <div class="container">
        <h1>Iniciar sesión</h1>

        <% if (error) { %>
            <p class="error"><%= error %></p>
        <% } %>

        <form action="/login" method="POST">
            <input
                type="email"
                name="email"
                placeholder="Correo electrónico"
                required
            >

            <input
                type="password"
                name="password"
                placeholder="Contraseña"
                required
            >

            <button type="submit">Entrar</button>
        </form>

        <p>¿No tienes cuenta? <a href="/register">Regístrate</a></p>
    </div>

</body>
</html>
