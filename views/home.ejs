<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            background: white;
            padding: 35px;
            border-radius: 12px;
            width: 400px;
            box-shadow: 0 4px 15px #00000015;
        }

        h1 { text-align: center; }

        .datos {
            background: #f1f5f9;
            padding: 15px;
            border-radius: 8px;
            overflow-wrap: anywhere;
        }

        a {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #2563eb;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Bienvenido</h1>

        <div class="datos">
            <p><strong>Correo electrónico:</strong></p>
            <p><%= email %></p>

            <p><strong>ID del usuario:</strong></p>
            <p><%= uid %></p>
        </div>

        <a href="/logout">Cerrar sesión</a>
    </div>

</body>
</html>
